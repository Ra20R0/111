# ── Локально ничего заполнять не нужно ──────────────────────────────
# Без DATABASE_URL проект работает на встроенной базе PGlite (.data/pglite).
# Вход в локальную админку: /admin/login — admin / ryba2026, курьер — courier / dostavka2026
# (только для компьютера; в онлайне пользователи создаются командой npm run create-admin).
ADMIN_LOGIN=admin
ADMIN_PASSWORD=ryba2026
COURIER_PASSWORD=dostavka2026

# ── Netlify → Site configuration → Environment variables ─────────────
# Адрес сайта — для ссылок в WhatsApp и картинок-превью
NEXT_PUBLIC_SITE_URL=https://rybka-semey.netlify.app
# Длинная случайная строка для подписи входа (см. README, как сгенерировать)
SESSION_SECRET=
# Supabase → Connect → «Transaction pooler» (порт 6543) — для сайта
DATABASE_URL=
# Supabase → Project Settings → API. Ключ service_role держите только на сервере!
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Публичный bucket для фото и видео
SUPABASE_BUCKET=media
